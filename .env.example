# Supabase — pegar em Project Settings > API no dashboard do Supabase
# NEXT_PUBLIC_* são expostas ao browser: só a anon key, nunca a service_role
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — só usada em Server Components/API Routes,
# NUNCA prefixar com NEXT_PUBLIC_, nunca expor ao client
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis — usado pelo rate limiting middleware
# Criar em https://console.upstash.com (free tier)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Autocomplete de endereço e mapa usam Nominatim/OpenStreetMap —
# gratuito, sem API key, nada pra configurar aqui


# Resend (email transacional)
RESEND_API_KEY=

# Sentry (erros/observabilidade)
NEXT_PUBLIC_SENTRY_DSN=
